# Advice for a Dollar — environment template
# Copy to .env and fill in. Never commit .env. Never hardcode credentials.
#
# Phase 1 (current) needs none of these. They are listed so the shape of the
# configuration is settled before the backend and payment phases land.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL, used to build magic links (/a/:token).
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (Phase 4)
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Admin (Phase 4)
# ---------------------------------------------------------------------------
# Argon2 hash of the owner's admin password. Never store the password itself.
ADMIN_PASSWORD_HASH=
# Secret used to sign the admin session cookie.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Payments (Phase 5)
# ---------------------------------------------------------------------------
# Which provider is live: mock | epoint | payriff
PAYMENT_PROVIDER=mock

# Currency is AZN by decision (see NOTES.md). Amounts are stored and sent as
# minor units — qəpik — so 1 AZN is 100.
PAYMENT_CURRENCY=AZN
PAYMENT_MINIMUM_MINOR_UNITS=100

# TODO(provider-docs): the exact credential names below must come from Epoint's
# and Payriff's own documentation. Do not guess them.
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
PAYRIFF_MERCHANT_ID=
PAYRIFF_SECRET_KEY=

# ---------------------------------------------------------------------------
# Email (Phase 4) — optional "your answer is ready" reminder.
# Addresses are purged 6 months after submission (see NOTES.md).
# ---------------------------------------------------------------------------
SMTP_URL=
MAIL_FROM=
